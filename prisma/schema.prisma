generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// CONTA FIXA DA DIREÇÃO - não tem cadastro
model Usuario {
  id      String @id @default(uuid())
  email     String @unique
  senha     String
  role     String //
}

model Empresa {
  id       String  @id @default(uuid())
  nome     String
  email    String  @unique
  aprovado Boolean @default(false) // Direção aprova
  estagios    estagio []
}

model Aluno {
  id     String @id @default(uuid())
  nome   String
  curso  String // Ex: Informática
  turma  String
  media  Float

}

model Estagio {
  id        String  @id @default(uuid())
  titulo    String
  descricao String
  cursoAlvo String // Ex: Informática
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}


model LogLogin {
  id      String   @id @default(cuid())
  email   String
  ip      String
  sucesso Boolean
  createdAt DateTime @default(now())
}